{
  "schema_version": 1,
  "project_id": "example",
  "data_roots": {"demo": "../examples/data"},
  "state_dir": "../.work/example",
  "excel": {
    "layout": {
      "logical_table_cell": "A1",
      "description_row": 2,
      "type_row": 4,
      "field_row": 5,
      "constraint_row": 6,
      "data_start_row": 7,
      "marker_column": "A",
      "start_marker": "Start",
      "end_marker": "End",
      "include_end": true,
      "skip_sheet_prefixes": ["$"]
    }
  },
  "tables": {
    "Catalog": [{"file": "Catalog.xlsx", "sheet": "配置"}],
    "Groups": [{"file": "Groups.xlsx", "sheet": "配置"}]
  },
  "references": [
    {"table": "Catalog", "field": "GroupId", "target_table": "Groups", "target_field": "Id", "nullable": false}
  ],
  "aliases": {},
  "knowledge": {
    "vault": "../obsidian-vault",
    "notes": "knowledge-notes.json",
    "index": "schema-index.json"
  }
}
